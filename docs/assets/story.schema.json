{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kirankumarduddu.github.io/multimodal-video-generator-gemini/assets/story.schema.json",
  "title": "Multimodal Video Generator story",
  "description": "A trailer as an ordered list of scenes. Card scenes are rendered from HTML in the brand's styling; live_action scenes are generated by a video model from an approved keyframe. Voice lines and music cues are placed on the same timeline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "logline", "aspect_ratio", "cast", "music", "scenes"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "logline": {"type": "string", "minLength": 1, "maxLength": 400, "description": "One or two sentences: who it is for and what they should feel or do."},
    "aspect_ratio": {"enum": ["16:9", "9:16"]},
    "cast": {
      "type": "array",
      "maxItems": 6,
      "description": "Invented, fictional people. Each gets one reference still so they look the same in every shot.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "description": {"type": "string", "minLength": 10, "maxLength": 400, "description": "Age range, look, hair, clothing. Never a real or famous person."}
        }
      }
    },
    "music": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "Score segments. Each starts at a scene and plays until the next segment; segments crossfade.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "starts_at", "prompt"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "starts_at": {"$ref": "#/$defs/slug", "description": "Scene id where this segment starts. The first segment must start at the first scene."},
          "align": {"enum": ["head", "tail"], "default": "head", "description": "tail plays the end of the take so its final chord lands on the last scene of the segment."},
          "prompt": {"type": "string", "minLength": 20, "maxLength": 1200, "description": "Instrumental score brief: length, BPM, instruments, emotional arc with timestamps, no vocals."}
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 60,
      "items": {"$ref": "#/$defs/scene"}
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"},
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 600},
        "at": {"type": "number", "minimum": 0, "default": 0.4, "description": "Seconds after the scene starts."}
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "cast": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/slug"}},
        "setting": {"type": "string", "maxLength": 400},
        "action": {"type": "string", "minLength": 10, "maxLength": 900, "description": "What happens, in plain visual language. No on-screen text, logos or interfaces."},
        "camera": {"type": "string", "maxLength": 300},
        "duration": {"enum": [4, 6, 8], "default": 8, "description": "Seconds of footage to generate. The scene's seconds may be shorter (the clip is trimmed)."}
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template"],
      "properties": {
        "template": {"enum": ["title", "statement", "feature", "list", "stat", "quote", "flow", "screen", "endcard"]},
        "eyebrow": {"type": "string", "maxLength": 60},
        "headline": {"type": "string", "maxLength": 140},
        "sub": {"type": "string", "maxLength": 260},
        "lines": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 80}, "description": "statement: lines revealed one by one."},
        "items": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 90}, "description": "list: bullets; flow: node labels in order."},
        "stats": {
          "type": "array", "maxItems": 4,
          "items": {"type": "object", "additionalProperties": false, "required": ["value", "label"],
                    "properties": {"value": {"type": "string", "maxLength": 16}, "label": {"type": "string", "maxLength": 60}}}
        },
        "quote": {"type": "string", "maxLength": 240},
        "by": {"type": "string", "maxLength": 80},
        "image": {"type": "string", "maxLength": 300, "description": "screen/feature: path relative to the project folder (a product screenshot or mockup)."},
        "cta": {"type": "string", "maxLength": 80}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "seconds"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["live_action", "card"]},
        "seconds": {"type": "number", "minimum": 1.5, "maximum": 30, "description": "Length on the timeline, including the 0.4 s crossfade into the next scene."},
        "trim_start": {"type": "number", "minimum": 0, "maximum": 6, "default": 0, "description": "live_action: seconds to skip at the start of the generated clip."},
        "shot": {"$ref": "#/$defs/shot"},
        "card": {"$ref": "#/$defs/card"},
        "caption": {"type": "string", "maxLength": 90, "description": "Optional lower caption over the scene."},
        "voice": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/voice"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "live_action"}}}, "then": {"required": ["shot"], "not": {"required": ["card"]}}},
        {"if": {"properties": {"kind": {"const": "card"}}}, "then": {"required": ["card"], "not": {"required": ["shot"]}}}
      ]
    }
  }
}
